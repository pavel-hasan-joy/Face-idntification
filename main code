<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>S.H.I.E.L.D. Biometric Scanner</title>
  
  <script defer src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api/dist/face-api.js"></script>

  <style>
    :root {
      --primary-glow: #00f0ff;
      --accent-red: #ff2a2a;
      --accent-gold: #ffd700;
      --bg-dark: #070b12;
      --panel-bg: rgba(10, 20, 35, 0.75);
      --font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--primary-glow);
      font-family: var(--font-family);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow-x: hidden;
      background-image: 
        radial-gradient(circle at 50% 50%, rgba(0, 240, 255, 0.1) 0%, transparent 80%),
        linear-gradient(0deg, rgba(0,0,0,0.9) 0%, rgba(7,11,18,0.8) 100%);
    }

    .hud-container {
      width: 95%;
      max-width: 1300px;
      border: 1px solid var(--primary-glow);
      box-shadow: 0 0 25px rgba(0, 240, 255, 0.2);
      padding: 20px;
      border-radius: 8px;
      background: var(--panel-bg);
      backdrop-filter: blur(10px);
    }

    .hud-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 15px;
      border-bottom: 2px solid var(--primary-glow);
      margin-bottom: 20px;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .logo {
      font-size: 1.5rem;
      font-weight: bold;
      text-shadow: 0 0 10px var(--primary-glow);
    }

    .status {
      padding: 5px 15px;
      border-radius: 4px;
      font-size: 0.85rem;
      font-weight: bold;
    }

    .status.warning { background: #553300; color: var(--accent-gold); border: 1px solid var(--accent-gold); }
    .status.active { background: #004422; color: #00ff88; border: 1px solid #00ff88; }

    .main-content {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 20px;
    }

    @media (max-width: 850px) {
      .main-content { grid-template-columns: 1fr; }
    }

    .panel {
      border: 1px solid rgba(0, 240, 255, 0.3);
      padding: 20px;
      border-radius: 5px;
      background: rgba(0, 10, 20, 0.5);
    }

    .panel h2, .panel h3 {
      margin-bottom: 15px;
      color: #fff;
      letter-spacing: 1px;
    }

    .input-group {
      margin-bottom: 15px;
    }

    .input-group label {
      display: block;
      margin-bottom: 5px;
      font-size: 0.9rem;
    }

    input[type="text"], input[type="file"] {
      width: 100%;
      padding: 10px;
      background: rgba(0, 240, 255, 0.05);
      border: 1px solid var(--primary-glow);
      color: #fff;
      border-radius: 4px;
    }

    button {
      width: 100%;
      padding: 12px;
      background: var(--primary-glow);
      color: #000;
      font-weight: bold;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 1px;
      transition: all 0.3s ease;
    }

    button:hover {
      background: #fff;
      box-shadow: 0 0 15px var(--primary-glow);
    }

    .viewport-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 16/9;
      background: #000;
      border: 2px solid var(--primary-glow);
      overflow: hidden;
      border-radius: 4px;
    }

    video, canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Laser Scan Animation & HUD Accents */
    .scan-line {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: var(--primary-glow);
      box-shadow: 0 0 15px var(--primary-glow);
      animation: scan 3s infinite linear;
      opacity: 0.7;
    }

    @keyframes scan {
      0% { top: 0%; }
      50% { top: 100%; }
      100% { top: 0%; }
    }

    .corner {
      position: absolute;
      width: 20px;
      height: 20px;
      border: 3px solid var(--accent-red);
    }

    .top-left { top: 10px; left: 10px; border-right: none; border-bottom: none; }
    .top-right { top: 10px; right: 10px; border-left: none; border-bottom: none; }
    .bottom-left { bottom: 10px; left: 10px; border-right: none; border-top: none; }
    .bottom-right { bottom: 10px; right: 10px; border-left: none; border-top: none; }

    .readout {
      margin-top: 15px;
      padding: 10px;
      background: rgba(0, 0, 0, 0.6);
      border-left: 4px solid var(--accent-gold);
      color: var(--accent-gold);
      font-family: monospace;
      font-size: 1.1rem;
    }

    .enrolled-list-container {
      margin-top: 20px;
    }

    #target-list {
      list-style: none;
      max-height: 150px;
      overflow-y: auto;
    }

    #target-list li {
      padding: 8px;
      border-bottom: 1px solid rgba(0,240,255,0.2);
      font-size: 0.9rem;
    }
  </style>
</head>
<body>
  <div class="hud-container">
    <header class="hud-header">
      <div class="logo">S.H.I.E.L.D. BIOMETRIC IDENTIFIER</div>
      <div id="status-badge" class="status warning">INITIALIZING AI...</div>
    </header>

    <main class="main-content">
      <section class="panel control-panel">
        <h2>Target Database Enrollment</h2>
        <form id="enrollment-form">
          <div class="input-group">
            <label for="person-name">Target Name:</label>
            <input type="text" id="person-name" placeholder="e.g. Tony Stark" required />
          </div>
          
          <div class="input-group">
            <label for="person-image">Reference Image (JPG/PNG):</label>
            <input type="file" id="person-image" accept="image/*" required />
          </div>

          <button type="submit" id="enroll-btn">Enroll Target</button>
        </form>

        <div class="enrolled-list-container">
          <h3>Enrolled Targets (<span id="target-count">0</span>)</h3>
          <ul id="target-list"></ul>
        </div>
      </section>

      <section class="panel camera-panel">
        <div class="viewport-wrapper">
          <video id="webcam" autoplay muted playsinline></video>
          <canvas id="overlay"></canvas>
          <div class="scan-line"></div>
          <div class="hud-corners">
            <span class="corner top-left"></span>
            <span class="corner top-right"></span>
            <span class="corner bottom-left"></span>
            <span class="corner bottom-right"></span>
          </div>
        </div>
        <div id="detection-readout" class="readout">AWAITING CAMERA ACCESS...</div>
      </section>
    </main>
  </div>

  <script>
    const MODEL_URL = 'https://cdn.jsdelivr.net/npm/@vladmandic/face-api/model/';

    const video = document.getElementById('webcam');
    const canvas = document.getElementById('overlay');
    const statusBadge = document.getElementById('status-badge');
    const readout = document.getElementById('detection-readout');
    const enrollForm = document.getElementById('enrollment-form');
    const targetListUI = document.getElementById('target-list');
    const targetCountUI = document.getElementById('target-count');

    let labeledDescriptors = [];
    let faceMatcher = null;
    let lastAnnouncedPerson = '';
    let lastAnnouncementTime = 0;

    // Speech Synthesis for Voice Alerts
    function speak(text) {
      const now = Date.now();
      if (text === lastAnnouncedPerson && now - lastAnnouncementTime < 4000) return;
      
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.pitch = 0.9;
      utterance.rate = 1.0;
      window.speechSynthesis.speak(utterance);

      lastAnnouncedPerson = text;
      lastAnnouncementTime = now;
    }

    // Load AI models and request camera access
    async function initApp() {
      readout.innerText = "LOADING AI RECOGNITION MODELS...";
      try {
        await Promise.all([
          faceapi.nets.ssdMobilenetv1.loadFromUri(MODEL_URL),
          faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL),
          faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL)
        ]);
        
        statusBadge.innerText = "MODELS LOADED";
        statusBadge.className = "status active";
        readout.innerText = "REQUESTING CAMERA PERMISSION...";
        
        startCamera();
      } catch (err) {
        console.error("Initialization error: ", err);
        readout.innerText = "ERROR LOADING MODELS OR CAMERA.";
      }
    }

    // Access webcam stream
    async function startCamera() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ video: {} });
        video.srcObject = stream;
        readout.innerText = "CAMERA ONLINE. READY FOR ENROLLMENT & SCANNING.";
        speak("Biometric scanner online. Ready for target recognition.");
      } catch (err) {
        readout.innerText = "CAMERA ACCESS DENIED OR UNAVAILABLE.";
        alert("Camera permission is required for real-time identification.");
      }
    }

    // Process uploaded target image
    enrollForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nameInput = document.getElementById('person-name').value.trim();
      const fileInput = document.getElementById('person-image').files[0];

      if (!fileInput || !nameInput) return;

      readout.innerText = `PROCESSING ENROLLMENT FOR: ${nameInput}...`;
      
      const img = await faceapi.bufferToImage(fileInput);
      const detection = await faceapi.detectSingleFace(img)
        .withFaceLandmarks()
        .withFaceDescriptor();

      if (!detection) {
        readout.innerText = `ERROR: NO FACE DETECTED IN IMAGE FOR ${nameInput}.`;
        speak("Enrollment failed. Face not detected in image.");
        return;
      }

      const descriptor = new faceapi.LabeledFaceDescriptors(nameInput, [detection.descriptor]);
      labeledDescriptors.push(descriptor);
      faceMatcher = new faceapi.FaceMatcher(labeledDescriptors, 0.6);

      const li = document.createElement('li');
      li.innerText = `✓ ${nameInput}`;
      targetListUI.appendChild(li);
      targetCountUI.innerText = labeledDescriptors.length;

      readout.innerText = `TARGET ENROLLED: ${nameInput.toUpperCase()}`;
      speak(`Target ${nameInput} enrolled successfully.`);

      enrollForm.reset();
    });

    // Real-time identification loop
    video.addEventListener('play', () => {
      const displaySize = { width: video.videoWidth || 640, height: video.videoHeight || 480 };
      faceapi.matchDimensions(canvas, displaySize);

      setInterval(async () => {
        if (video.paused || video.ended) return;

        const detections = await faceapi.detectAllFaces(video)
          .withFaceLandmarks()
          .withFaceDescriptors();

        const resizedDetections = faceapi.resizeResults(detections, displaySize);
        
        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        if (resizedDetections.length === 0) {
          readout.innerText = "SCANNING FOR TARGETS...";
          return;
        }

        resizedDetections.forEach(detection => {
          let label = 'Unknown Subject';
          
          if (faceMatcher) {
            const bestMatch = faceMatcher.findBestMatch(detection.descriptor);
            label = bestMatch.toString();
          }

          const box = detection.detection.box;
          
          ctx.strokeStyle = label.includes('unknown') ? '#ff2a2a' : '#00f0ff';
          ctx.lineWidth = 3;
          ctx.strokeRect(box.x, box.y, box.width, box.height);

          ctx.fillStyle = label.includes('unknown') ? '#ff2a2a' : '#00f0ff';
          ctx.font = '16px Segoe UI';
          ctx.fillText(label.toUpperCase(), box.x, box.y > 20 ? box.y - 10 : 20);

          if (!label.includes('unknown')) {
            const detectedName = label.split(' ')[0];
            readout.innerText = `TARGET IDENTIFIED: ${detectedName.toUpperCase()}`;
            speak(`Target identified: ${detectedName}`);
          } else {
            readout.innerText = "UNIDENTIFIED SUBJECT DETECTED.";
          }
        });
      }, 200);
    });

    window.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
</html>
