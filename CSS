:root {
  --primary-glow: #00f0ff;
  --accent-red: #ff2a2a;
  --accent-gold: #ffd700;
  --bg-dark: #070b12;
  --panel-bg: rgba(10, 20, 35, 0.75);
  --font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--bg-dark);
  color: var(--primary-glow);
  font-family: var(--font-family);
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow-x: hidden;
  background-image: 
    radial-gradient(circle at 50% 50%, rgba(0, 240, 255, 0.1) 0%, transparent 80%),
    linear-gradient(0deg, rgba(0,0,0,0.9) 0%, rgba(7,11,18,0.8) 100%);
}

.hud-container {
  width: 95%;
  max-width: 1300px;
  border: 1px solid var(--primary-glow);
  box-shadow: 0 0 25px rgba(0, 240, 255, 0.2);
  padding: 20px;
  border-radius: 8px;
  background: var(--panel-bg);
  backdrop-filter: blur(10px);
}

.hud-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 15px;
  border-bottom: 2px solid var(--primary-glow);
  margin-bottom: 20px;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.logo {
  font-size: 1.5rem;
  font-weight: bold;
  text-shadow: 0 0 10px var(--primary-glow);
}

.status {
  padding: 5px 15px;
  border-radius: 4px;
  font-size: 0.85rem;
  font-weight: bold;
}

.status.warning { background: #553300; color: var(--accent-gold); border: 1px solid var(--accent-gold); }
.status.active { background: #004422; color: #00ff88; border: 1px solid #00ff88; }

.main-content {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 20px;
}

@media (max-width: 850px) {
  .main-content { grid-template-columns: 1fr; }
}

.panel {
  border: 1px solid rgba(0, 240, 255, 0.3);
  padding: 20px;
  border-radius: 5px;
  background: rgba(0, 10, 20, 0.5);
}

.panel h2, .panel h3 {
  margin-bottom: 15px;
  color: #fff;
  letter-spacing: 1px;
}

.input-group {
  margin-bottom: 15px;
}

.input-group label {
  display: block;
  margin-bottom: 5px;
  font-size: 0.9rem;
}

input[type="text"], input[type="file"] {
  width: 100%;
  padding: 10px;
  background: rgba(0, 240, 255, 0.05);
  border: 1px solid var(--primary-glow);
  color: #fff;
  border-radius: 4px;
}

button {
  width: 100%;
  padding: 12px;
  background: var(--primary-glow);
  color: #000;
  font-weight: bold;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  text-transform: uppercase;
  letter-spacing: 1px;
  transition: all 0.3s ease;
}

button:hover {
  background: #fff;
  box-shadow: 0 0 15px var(--primary-glow);
}

.viewport-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 16/9;
  background: #000;
  border: 2px solid var(--primary-glow);
  overflow: hidden;
  border-radius: 4px;
}

video, canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Marvel/HUD Corner Accents & Laser Scan Line */
.scan-line {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4px;
  background: var(--primary-glow);
  box-shadow: 0 0 15px var(--primary-glow);
  animation: scan 3s infinite linear;
  opacity: 0.7;
}

@keyframes scan {
  0% { top: 0%; }
  50% { top: 100%; }
  100% { top: 0%; }
}

.corner {
  position: absolute;
  width: 20px;
  height: 20px;
  border: 3px solid var(--accent-red);
}

.top-left { top: 10px; left: 10px; border-right: none; border-bottom: none; }
.top-right { top: 10px; right: 10px; border-left: none; border-bottom: none; }
.bottom-left { bottom: 10px; left: 10px; border-right: none; border-top: none; }
.bottom-right { bottom: 10px; right: 10px; border-left: none; border-top: none; }

.readout {
  margin-top: 15px;
  padding: 10px;
  background: rgba(0, 0, 0, 0.6);
  border-left: 4px solid var(--accent-gold);
  color: var(--accent-gold);
  font-family: monospace;
  font-size: 1.1rem;
}

.enrolled-list-container {
  margin-top: 20px;
}

#target-list {
  list-style: none;
  max-height: 150px;
  overflow-y: auto;
}

#target-list li {
  padding: 8px;
  border-bottom: 1px solid rgba(0,240,255,0.2);
  font-size: 0.9rem;
}
